# Copia este archivo a .streamlit/secrets.toml y completa con tus valores reales.
# NUNCA subas el secrets.toml real a un repositorio público.

SUPABASE_URL = "https://TU-PROYECTO.supabase.co"
SUPABASE_ANON_KEY = "TU-ANON-KEY-PUBLICA"

# SOLO necesaria para el panel de administrador. Encuéntrala en
# Project Settings > API > "service_role" (secret). Esta clave IGNORA
# por completo las políticas RLS: cualquiera que la tenga puede leer y
# modificar los datos de TODOS los usuarios. Nunca la subas a un
# repositorio, nunca la pongas en el código fuente, nunca la muestres
# en pantalla dentro de la app. En Streamlit va solo aquí, en secrets.
SUPABASE_SERVICE_ROLE_KEY = "TU-SERVICE-ROLE-KEY-SECRETA"

# Clave para cifrar la cookie de sesión en el navegador del usuario.
# Genera una cadena aleatoria larga y única para tu despliegue.
COOKIE_PASSWORD = "genera-una-clave-larga-y-aleatoria-aqui"
